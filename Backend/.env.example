PORT=5000

# MongoDB Atlas connection string (create a free cluster at cloud.mongodb.com)
MONGO_URI=

# any random string, e.g: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

FRONTEND_URL=http://localhost:5173

# Cloudinary (cloudinary.com) - used for product image + try-on overlay uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# optional - password reset emails fall back to a shared Mailtrap sandbox
# inbox if these are left blank, so it's fine to skip this for local dev
EMAIL_USER=
EMAIL_PASS=
